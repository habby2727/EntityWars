[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/world_zone.gd" id="1_world_zone"]
[ext_resource type="Script" path="res://scripts/net/backend_client.gd" id="2_backend_client"]
[ext_resource type="Script" path="res://scripts/ui/back_button.gd" id="3_back_button"]

[node name="WorldZone" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_world_zone")
backend_path = NodePath("BackendClient")
background_path = NodePath("Background")
header_label_path = NodePath("Overlay/Margin/RootVBox/Header/Title")
session_label_path = NodePath("Overlay/Margin/RootVBox/SessionLabel")
modifier_label_path = NodePath("Overlay/Margin/RootVBox/ModifierLabel")
heat_label_path = NodePath("Overlay/Margin/RootVBox/HeatLabel")
enter_button_path = NodePath("Overlay/Margin/RootVBox/Buttons/EnterButton")
farm_count_path = NodePath("Overlay/Margin/RootVBox/Buttons/FarmCount")
farm_button_path = NodePath("Overlay/Margin/RootVBox/Buttons/FarmButton")
claim_button_path = NodePath("Overlay/Margin/RootVBox/Buttons/ClaimButton")
error_label_path = NodePath("Overlay/Margin/RootVBox/ErrorLabel")
back_button_path = NodePath("Overlay/Margin/RootVBox/Header/BackButton")

[node name="BackendClient" type="Node" parent="."]
script = ExtResource("2_backend_client")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 5

[node name="Overlay" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 100
theme_override_constants/margin_top = 120
theme_override_constants/margin_right = 100
theme_override_constants/margin_bottom = 120

[node name="RootVBox" type="VBoxContainer" parent="Overlay/Margin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Overlay/Margin/RootVBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Overlay/Margin/RootVBox/Header"]
layout_mode = 2
text = "ZONE"
theme_override_font_sizes/font_size = 28

[node name="Spacer" type="Control" parent="Overlay/Margin/RootVBox/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BackButton" type="Button" parent="Overlay/Margin/RootVBox/Header"]
layout_mode = 2
text = "Back"
script = ExtResource("3_back_button")
target = "lab_hub"

[node name="SessionLabel" type="Label" parent="Overlay/Margin/RootVBox"]
layout_mode = 2
text = "Session: -"

[node name="ModifierLabel" type="Label" parent="Overlay/Margin/RootVBox"]
layout_mode = 2
text = "Modifiers: -"

[node name="HeatLabel" type="Label" parent="Overlay/Margin/RootVBox"]
layout_mode = 2
text = "Heat: 0 | Rep: 0"

[node name="Buttons" type="HBoxContainer" parent="Overlay/Margin/RootVBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="EnterButton" type="Button" parent="Overlay/Margin/RootVBox/Buttons"]
layout_mode = 2
text = "Enter"

[node name="FarmCount" type="OptionButton" parent="Overlay/Margin/RootVBox/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(80, 0)

[node name="FarmButton" type="Button" parent="Overlay/Margin/RootVBox/Buttons"]
layout_mode = 2
text = "Farm"

[node name="ClaimButton" type="Button" parent="Overlay/Margin/RootVBox/Buttons"]
layout_mode = 2
text = "Claim"

[node name="ErrorLabel" type="Label" parent="Overlay/Margin/RootVBox"]
layout_mode = 2
text = ""
modulate = Color(1, 0.35, 0.35, 1)
