; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EntityWars"
run/main_scene="res://scenes/ui/Auth.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/ui/ew-icon.png"

[autoload]

GameLocalization="*res://scripts/ui/game_localization.gd"
DropdownStyle="*res://scripts/ui/dropdown_style.gd"
WindowModeManager="*res://scripts/ui/window_mode_manager.gd"
GameTypography="*res://scripts/ui/game_typography.gd"
ScrollbarStyle="*res://scripts/ui/scrollbar_style.gd"
ConnectionGate="*res://scripts/net/connection_gate.gd"
SocialClient="*res://scripts/net/social_client.gd"
DuelClient="*res://scripts/net/duel_client.gd"
WoeClient="*res://scripts/net/woe_client.gd"
CoreDefenseClient="*res://scripts/net/core_defense_client.gd"
GlobalChatClient="*res://scripts/net/global_chat_client.gd"
SpectatorClient="*res://scripts/net/spectator_client.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://i18n/ui.en.translation", "res://i18n/ui.es.translation", "res://i18n/catalog.en.translation", "res://i18n/catalog.es.translation", "res://i18n/lab.en.translation", "res://i18n/lab.es.translation", "res://i18n/gameplay.en.translation", "res://i18n/gameplay.es.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
