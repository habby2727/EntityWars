# Replace with a real DNS hostname, without scheme, port or path.
SITE_ADDRESS=replace-with-your-hostname
# Forest presence is disabled by default. Enable only after F4B and validation.
# FOREST_WS_ENABLED=1
# Enabled API instances must share the same Redis primary for the leader lease.
# Redis failover can lose lease writes; this lease is not a consensus guarantee.
# Generate each independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
TOKEN_SIGNING_SECRET=
EXPERIMENT_SECRET=
TRADE_SECRET=
WORLD_SECRET=
