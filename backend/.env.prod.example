# Replace with a real DNS hostname, without scheme, port or path.
SITE_ADDRESS=replace-with-your-hostname
# Forest presence is disabled by default. Only set these in the API container
# after deploying a compatible client and ensuring exactly one API process.
# FOREST_WS_ENABLED=1
# FOREST_WS_SINGLE_INSTANCE=1
# This is an operator assertion, not distributed replica detection. The current
# compose file does not pass these variables through; inject them explicitly.
# Generate each independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
TOKEN_SIGNING_SECRET=
EXPERIMENT_SECRET=
TRADE_SECRET=
WORLD_SECRET=
