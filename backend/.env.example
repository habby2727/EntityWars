# Backend runtime
NODE_ENV=development
BUN_ENV=development

# SQLite dev path (existing)
DB_PATH=data/dev.sqlite

# Postgres (optional but recommended)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/entity_wars
PG_POOL_SIZE=10
PG_IDLE_TIMEOUT_SECONDS=30
PG_CONNECT_TIMEOUT_SECONDS=10
PG_MAX_LIFETIME_SECONDS=0

# Redis (optional but recommended)
REDIS_URL=redis://127.0.0.1:6379/0

# Sessions
SESSION_TTL_SECONDS=86400
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600
TOKEN_SIGNING_SECRET=dev_change_me

# Login rate limit
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_SECONDS=600
REFRESH_RATE_LIMIT_MAX=20
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=60
EXPENSIVE_RATE_LIMIT_MAX=60

# CORS (comma-separated origins). Empty = localhost only in dev.
CORS_ORIGINS=

# Requests
MAX_BODY_BYTES=262144

# Jobs
JOB_POLL_MS=2000
JOB_BATCH_SIZE=5
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_MS=1000

# Optional: run examples on boot
PG_EXAMPLE=0
REDIS_EXAMPLE=0

# Dev bypass (requires X-Debug-Bypass: 1 header)
DEBUG_BYPASS=0
